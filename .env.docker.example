# Database (for docker-compose.dev / prod)
DB_USER=cw_user
DB_PASSWORD=change_me_strong_password
DB_NAME=cipherwarden

# Or set this directly for prod-external-db:
# DATABASE_URL=postgresql://user:pass@neon.tech/db?sslmode=require

# Backend
NODE_ENV=production
SESSION_SECRET=generate_a_64_char_hex_here
CLIENT_ORIGIN=http://localhost
COOKIE_NAME=cw_session
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
MASTER_KEY=generate_an_argon2_master_key_here

# Frontend is built with relative /api/v1 path; no VITE_ needed.
