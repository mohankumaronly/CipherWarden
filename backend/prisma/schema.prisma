generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-row vault configuration. Only one vault exists per deployment.
model Vault {
  id                String   @id @default(uuid())
  kdfAlgorithm      String   @default("ARGON2ID")
  kdfMemoryKiB      Int      @default(65536)
  kdfIterations     Int      @default(3)
  kdfParallelism    Int      @default(4)
  kdfOutputLength   Int      @default(64)
  salt              String
  keyEncryptionAlgo String   @default("AES-256-GCM")
  wrappedVaultKey   String
  keyNonce          String
  encryptionVersion Int      @default(1)
  authVerifierHash  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items     VaultItem[]
  folders   Folder[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@map("vaults")
}

/// Organisational folder for vault items. Optional grouping only.
model Folder {
  id        String     @id @default(uuid())
  vaultId   String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  vault Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  items VaultItem[]

  @@index([vaultId])
  @@map("folders")
}

/// A single encrypted entry in the vault (login, card, …).
/// The DB table is vault_items; the old `credentials` table is migrated into it.
model VaultItem {
  id                String   @id @default(uuid())
  vaultId           String
  /// Discriminator: "LOGIN" | "CARD" (open string to allow future types without migrations)
  type              String   @default("LOGIN")
  folderId          String?
  ciphertext        String
  nonce             String
  encryptionVersion Int      @default(1)
  recordVersion     Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vault  Vault   @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([vaultId])
  @@index([folderId])
  @@map("vault_items")
}

model Session {
  id        String   @id @default(uuid())
  vaultId   String
  tokenHash String   @unique
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  vault Vault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  vaultId   String?
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  vault Vault? @relation(fields: [vaultId], references: [id], onDelete: SetNull)

  @@index([vaultId])
  @@index([createdAt])
  @@map("audit_logs")
}
